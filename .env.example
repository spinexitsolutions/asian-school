# MongoDB Atlas connection string (Atlas > Connect > Drivers)
DATABASE_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/asian-school
# Long random string, e.g. output of: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudinary (optional locally; recommended in production so uploads survive redeploys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP for enquiry email alerts (optional) — Hostinger email: smtp.hostinger.com, port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
