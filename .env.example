# Database.
# Local (default): MongoDB on this computer — start it with `npm run db:local`
# or use an installed MongoDB Community Server. Leaving this empty also uses local.
DATABASE_URI=mongodb://127.0.0.1:27017/asian-school
# Live site: replace with the MongoDB Atlas link (Atlas > Connect > Drivers), e.g.
# DATABASE_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/asian-school
# Long random text used to sign admin logins, e.g. output of: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudinary (optional). Without it, uploads are saved in the ./uploads folder on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP for enquiry email alerts (optional) — Hostinger email: smtp.hostinger.com, port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
